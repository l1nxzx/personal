# Copy to .env (gitignored) and fill in.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=1209600

# lax works when the browser sees one origin (Vite proxy locally, Netlify /api proxy in prod).
COOKIE_SAMESITE=lax
# Private site: keep registration closed and create the owner with `npm run create-super-admin`.
ALLOW_REGISTRATION=false

# Firebase (server only)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Optional locally, required with more than one instance (rate limits + SSE fan-out)
REDIS_URL=

LOG_LEVEL=info
